// Inspired by Catnap (https://github.com/iinsertNameHere/catnap)
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // "type": "small",
    "padding": {
      "top": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    "title",
    "separator",
    {
      "key": "╭────────────╮",
      "type": "custom"
    },
    {
      "key": "│ {#31}{icon} uptime   {#keys}│",
      "type": "uptime"
    },
    {
      "key": "│ {#32}{icon} distro   {#keys}│",
      "type": "os"
    },
    {
      "key": "│ {#33}{icon} kernel   {#keys}│",
      "type": "kernel"
    },
    {
      "key": "│ {#34}{icon} packages {#keys}│",
      "type": "packages"
    },
    {
      "key": "│ {#35}{icon} desktop  {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#36}{icon} term     {#keys}│",
      "type": "terminal"
    },
    {
      "key": "│ {#31}{icon} shell    {#keys}│",
      "type": "shell"
    },
    {
      "key": "│ {#32}{icon} cpu      {#keys}│",
      "type": "cpu",
      "showPeCoreCount": true
    },
    {
      "key": "│ {#33}{icon} gpu      {#keys}│",
      "type": "gpu"
    },
    {
      "key": "│ {#34}{icon} display  {#keys}│",
      "type": "display"
    },
    {
      "key": "│ {#35}{icon} window   {#keys}│",
      "type": "wm"
    },
    {
      "key": "│ {#36}{icon} desktop  {#keys}│",
      "type": "de"
    },
    {
      "key": "│ {#31}{icon} disk     {#keys}│",
      "type": "disk",
      "folders": "/"
    },
    {
      "key": "│ {#32}{icon} memory   {#keys}│",
      "type": "memory"
    },
    {
      "key": "│ {#33}{icon} network  {#keys}│",
      "type": "localip",
      "format": "{ipv4} ({ifname})"
    },
    {
      "key": "├────────────┤",
      "type": "custom"
    },
    {
      "key": "│ {#39}{icon} colors   {#keys}│",
      "type": "colors",
      "symbol": "square"
    },
    {
      "key": "╰────────────╯",
      "type": "custom"
    }
  ]
}
